#pragma once

#define PLUGIN_ID "@ETA_PLUGIN_ID@"
#define PLUGIN_VERSION "@ETA_PLUGIN_VERSION@"
#define PLUGIN_NAME "@ETA_PLUGIN_NAME@"
#define PLUGIN_LOG_PATH "/data/etaHEN/@ETA_PLUGIN_ID@.log"
#define PLUGIN_SETTINGS_PATH "/data/etaHEN/plugins/@ETA_PLUGIN_ID@.ini"

/* Orbit Store defaults (see TOSanthony/orbit-store launcher/README.md and
 * app/README.md): the launcher persists the service ELF under
 * /data/orbit-store/, and the TV app FFPKG is picked up by ShadowMountPlus
 * from /data/homebrew/. */
#define ORBIT_DEFAULT_ELF_PATH "/data/orbit-store/orbit_store.elf"
#define ORBIT_DEFAULT_SEARCH_PATH "/data/orbit-store"
#define ORBIT_HOMEBREW_DIR "/data/homebrew"
#define ORBIT_SERVICE_PROC_NAME "orbit_store.elf"
